# Copy to .env and adjust. DJANGO_ENV selects settings: local | dev | prod
# For host-machine dev, use .env.local.example (localhost URLs).
# For Docker-only dev, these service hostnames work as-is in .env too.
DJANGO_ENV=local

# Django
SECRET_KEY=change-me-in-non-local-environments
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*

# Database (docker-compose service names when running in containers)
DATABASE_URL=postgres://mixed_miles:mixed_miles@postgres:5432/mixed_miles

# Read replica (disabled by default — enable when you add a replica in MVP+)
DATABASE_REPLICA_ENABLED=False
# DATABASE_REPLICA_URL=postgres://mixed_miles:mixed_miles@postgres-replica:5432/mixed_miles

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# CORS — include landing + admin dashboard origins
# Local:
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Production example:
# CORS_ALLOWED_ORIGINS=https://mixedmiles.com,https://www.mixedmiles.com,https://admin.mixedmiles.com

# Didit identity verification (OCR-only workflow in Didit console)
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
# Browser return after Didit (NOT the server webhook). Mobile sends its own
# deep link (mixedmiles://identity-callback) and closes the in-app browser.
# Keep this as a fallback for web/registration only, e.g.:
# DIDIT_CALLBACK_URL=https://YOUR-SUBDOMAIN.ngrok-free.dev/api/v1/accounts/verify-test/
# Server webhook: https://YOUR-SUBDOMAIN.ngrok-free.dev/api/v1/accounts/webhooks/didit/
DIDIT_CALLBACK_URL=
VERIFY_TEST_PAGE_ENABLED=True

RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL="Mixed Miles <hello@mixedmiles.com>"
EMAIL_BRAND_LOGO_URL=https://mixedmiles.com/assets/mixed-miles-logo-CPWQdpDb.png
PASSWORD_RESET_FRONTEND_URL=https://mixedmiles.com/reset-password
ADMIN_DASHBOARD_URL=https://admin.mixedmiles.com

# Google Sheets service account (City Founder applications form responses).
# Values come from the Google Cloud service-account JSON key. Keep the \n
# escapes in GOOGLE_SA_PRIVATE_KEY (single line, wrapped in double quotes).
GOOGLE_SA_PROJECT_ID=
GOOGLE_SA_PRIVATE_KEY_ID=
GOOGLE_SA_PRIVATE_KEY=""
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_CLIENT_ID=
FOUNDER_APPLICATIONS_SHEET_NAME=mixed_miles_city_founder_application (Responses)
# Spreadsheet ID from the URL: https://docs.google.com/spreadsheets/d/<ID>/edit
# Prefer this over NAME (NAME requires Google Drive API to be enabled).
FOUNDER_APPLICATIONS_SHEET_ID=

# S3 media — local dev uses MinIO from docker-compose (no AWS account needed).
# Docker: credentials are set via docker-compose x-app-environment overrides.
# Host machine: point at localhost:9000 (start MinIO with `docker compose up minio minio-init -d`).
AWS_S3_ACCESS_KEY_ID=minioadmin
AWS_S3_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=mixed-miles-media
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
MEDIA_CDN_BASE_URL=http://localhost:9000/mixed-miles-media